# Copy to deploy/.env, keep it private, and run Compose from deploy/.
# Defaults to latest when omitted; pin each published vX.Y.Z for predictable upgrades.
WEB_VERSION=latest
API_VERSION=latest
WEB_PORT=8080
APP_URL=http://localhost:8080
# Generate once with: php artisan key:generate --show
APP_KEY=
# For an external PostgreSQL server, set DB_HOST to its address.
# For the bundled database, leave DB_HOST=postgres and use --profile bundled-db.
# External managed databases may require DB_SSLMODE=require or verify-full;
# configure certificates and hostnames according to the provider's requirements.
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=wallpaper
DB_USERNAME=wallpaper
DB_PASSWORD=
