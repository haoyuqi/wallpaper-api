# Copy this file to deploy/.env, keep it private, and run Compose from deploy/.
# This file is both the Compose variable file and the container environment file.
# Pin published vX.Y.Z tags for predictable upgrades and rollback.
COMPOSE_ENV_FILE=.env
# Bundled services: database,redis. Leave empty to use existing services.
# Select only what is needed; each dependency is independent.
COMPOSE_PROFILES=database,redis

WEB_VERSION=latest
API_VERSION=latest
# Bind only to the loopback interface. A public reverse proxy should reach the
# containers through the ingress network instead of this published port.
WEB_BIND=127.0.0.1
WEB_PORT=8080

APP_NAME="Wallpaper API"
# Generate once with: php artisan key:generate --show
APP_KEY=
# Public HTTPS origin of the API when it is exposed directly.
APP_URL=http://localhost:8080
# Comma-separated CIDRs of the reverse proxies whose forwarded headers are trusted.
# Required when the API runs behind ingress-nginx or another proxy.
TRUSTED_PROXIES=

DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=wallpaper
DB_USERNAME=wallpaper
DB_PASSWORD=
# Use disable on a private Docker network; managed providers may require require
# or verify-full with the provider's CA and hostname configuration.
DB_SSLMODE=prefer

# Use redis to share counters and cache across workers and restarts. The image
# bundles the phpredis extension; no rebuild is needed.
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
# Leave username and password empty for the bundled Redis. On a shared Redis,
# use a dedicated ACL user and a unique prefix for every application.
REDIS_USERNAME=
REDIS_PASSWORD=
# The default connection is unused by this service but should still be explicit
# when the instance is shared; the cache store uses REDIS_CACHE_DB. This template
# reserves DB6 for both and a wallpaper: prefix for the ACL rule. Verify the
# database is free before pointing at a shared instance, and keep the ACL key
# pattern aligned with REDIS_PREFIX.
REDIS_DB=6
REDIS_CACHE_DB=6
REDIS_PREFIX=wallpaper:
CACHE_PREFIX=cache:

WALLPAPER_REQUESTS_PER_MINUTE=60
# Comma-separated browser origins allowed to read the API. Use * only when the
# API is intentionally public to every site.
CORS_ALLOWED_ORIGINS=*

# Production networks. Leave the defaults for bundled dependencies. To reuse
# existing services, set *_NETWORK_EXTERNAL=true and provide the network name.
POSTGRES_NETWORK_EXTERNAL=false
REDIS_NETWORK_EXTERNAL=false
INGRESS_NETWORK_EXTERNAL=false
# POSTGRES_NETWORK=infra-postgres-private
# REDIS_NETWORK=infra-redis-private
# INGRESS_NETWORK=ingress-nginx_default

WEB_MEMORY_LIMIT=64m
WEB_CPU_LIMIT=0.25
API_MEMORY_LIMIT=384m
API_CPU_LIMIT=0.75
SCHEDULER_MEMORY_LIMIT=192m
SCHEDULER_CPU_LIMIT=0.25
DATABASE_MEMORY_LIMIT=256m
DATABASE_CPU_LIMIT=0.5
REDIS_MEMORY_LIMIT=96m
REDIS_CPU_LIMIT=0.2
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3
