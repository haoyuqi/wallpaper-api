APP_NAME="Wallpaper API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

CORS_ALLOWED_ORIGINS=*
WALLPAPER_REQUESTS_PER_MINUTE=60

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

# Dedicated PHPUnit connection. Set the password only in your ignored .env.
TEST_DB_CONNECTION=pgsql
TEST_DB_HOST=postgres
TEST_DB_PORT=5432
TEST_DB_DATABASE=wallpaper_api_test
TEST_DB_USERNAME=wallpaper_test
TEST_DB_PASSWORD=

CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
